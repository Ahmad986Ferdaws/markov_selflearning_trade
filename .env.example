# Database
DATABASE_URL=sqlite:///./paper_trading.db

# Polling (seconds)
POLL_INTERVAL_SECONDS=15

# Regime (Phase 0)
REGIME_SYMBOL=BTC-USD
REGIME_WINDOW=20
REGIME_BULL_THRESH=0.02
REGIME_BEAR_THRESH=-0.02
BENCHMARK_SYMBOL=BTC-USD

# Paper ledger
STARTING_CASH=1000.0

# Risk guards (see docs/03-risk-guards.md)
MAX_ALLOCATION_PCT=20.0
LIQUIDITY_FLOOR_USD=50000.0
FEE_PCT=0.3
SLIPPAGE_PCT=0.5

# LLM provider for the Phase C agent — anthropic | ollama | none (keys from env ONLY)
LLM_PROVIDER=none
# Anthropic (hosted). Leave the key empty here; set it only in your local .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Ollama (local, free) — used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b